# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---- AI (title & description generation) ----
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# ---- Microsoft / SharePoint (sprint sheet) ----
SHAREPOINT_EMAIL=you@yourcompany.com
SHAREPOINT_PASSWORD=your_microsoft_password

# ---- Nexus login ----
# Optional: leave empty to reuse the SHAREPOINT_* credentials above
NEXUS_EMAIL=
NEXUS_PASSWORD=
